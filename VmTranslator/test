#!/bin/zsh

set -e

test_dir="${0:A:h}"
project_dir="${test_dir:h}"
cd "$project_dir"

VmTranslator/build

run_test() {
    local name="$1"
    local expected_name="$2"
    local source="VmTranslator/Tests/${name}.vm"
    local expected="VmTranslator/Tests/${expected_name}.asm"
    local generated="VmTranslator/Tests/${name}.generated.asm"

    echo "Testing ${name}..."
    ./VmTranslator/vmtranslator "$source" "$generated"
    diff -u <(awk '!/^[[:space:]]*(\/\/|$)/ { sub(/[[:space:]]+$/, ""); print }' "$expected") \
        <(awk '!/^[[:space:]]*(\/\/|$)/ { sub(/[[:space:]]+$/, ""); print }' "$generated")
    rm -f "$generated"
    echo "${name}: passed"
}

trap 'rm -f VmTranslator/Tests/*.generated.asm(N)' EXIT

run_test "Basic" "BasicTest"
run_test "SimpleAdd" "SimpleAdd"
run_test "BasicLoop" "BasicLoopTest"
run_test "SimpleFunction" "SimpleFunctionTest"

echo "All tests passed."