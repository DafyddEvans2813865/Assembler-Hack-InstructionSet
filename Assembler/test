#!/bin/zsh

set -e

test_dir="${0:A:h}"
project_dir="${test_dir:h}"
cd "$project_dir"

Assembler/build

run_test() {
    local name="$1"
    local source="Assembler/Tests/examples/${name}.asm"
    local expected="Assembler/Tests/examples/${name}Test.hack"
    local generated="Assembler/Tests/examples/${name}.hack"

    echo "Testing ${name}..."
    ./Assembler/assembler "$source"
    diff -u "$expected" "$generated"
    echo "${name}: passed"
}

run_test "Add"
run_test "Max"

echo "All tests passed."
